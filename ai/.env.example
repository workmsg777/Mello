MATCHING_AI_KEY=replace-with-an-independent-random-secret-at-least-32-characters
AI_EMBEDDINGS_ENABLED=false
PHOTO_MODERATION_MODE=off
# Defaults to .cache/vision/marqo.onnx
# AI_PHOTO_MODEL_PATH=.cache/vision/marqo.onnx
SELFIE_VERIFICATION_TEST_ENABLED=false
AI_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Pin the model commit in deployed environments.
AI_MODEL_REVISION=e8f8c211226b894fcb81acc59f3b34ba3efd5f42
# Pre-provision the model cache. Set false only for an intentional initial model download.
AI_MODEL_LOCAL_ONLY=true
# Defaults to this service's .cache/huggingface/hub; use a mounted cache in containers.
AI_MODEL_CACHE_DIR=.cache/huggingface/hub
