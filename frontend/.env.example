# Leave empty to use the Expo development computer's LAN address automatically.
# For a separate API host, a tunnel, or production, set an explicit reachable URL.
EXPO_PUBLIC_API_URL=

# Optional: use direct Android FCM / iOS APNs instead of Expo Push Service.
# Requires matching backend provider credentials and a new native build.
EXPO_PUBLIC_PUSH_TRANSPORT=expo
# Build-time path to this app's Firebase Android configuration file.
GOOGLE_SERVICES_FILE=
