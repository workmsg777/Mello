{
  "expo": {
    "name": "Mello Partner",
    "slug": "mello-partner",
    "scheme": "mello-partner",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Mello Partner uses your photos to publish café menus, packages and events."
        }
      ],
      "expo-notifications"
    ],
    "android": {
      "package": "com.mello.partner",
      "predictiveBackGestureEnabled": false
    },
    "ios": {
      "bundleIdentifier": "com.mello.partner",
      "supportsTablet": true
    }
  }
}
