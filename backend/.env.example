PORT=4000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dating_db
DB_USER=dating_user
DB_PASSWORD=dating_password
DB_SSL=false
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
OTP_HASH_SECRET=replace-with-an-independent-long-random-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
OTP_TTL_SECONDS=300
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
DEFAULT_PHONE_COUNTRY_CODE=+91
OTP_DELIVERY_MODE=console
# To send real SMS, set OTP_DELIVERY_MODE=twilio and configure these credentials.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# Use a messaging service above, or a Twilio sender number below.
TWILIO_FROM_NUMBER=
# Local development only. Never enable this in production.
OTP_EXPOSE_IN_RESPONSE=true
PLATFORM_SIGNUP_SECRET=replace-with-a-private-platform-registration-key
DATING_MINIMUM_AGE=18
DATING_MINIMUM_PHOTOS=3
DATING_MAXIMUM_PHOTOS=6
DATING_MINIMUM_INTERESTS=3
DATING_MAXIMUM_INTERESTS=8
DATING_MAXIMUM_PROMPT_ANSWERS=3
CONSENT_POLICY_VERSION=1.0

# Discovery ranking: BASELINE, RULES (default), or HYBRID.
# Both users must grant current PERSONALIZED_MATCHING consent for real scores.
MATCHING_MODE=RULES
PHOTO_MODERATION_MODE=off
# Explicitly set a calibrated 0 <= threshold < 0.5 to enable auto approval.
# PHOTO_MODERATION_APPROVE_MAX_RISK=0.01
MATCHING_ROLLOUT_PERCENT=100
# Use RULES as the holdout for an optional HYBRID experiment.
MATCHING_ROLLOUT_CONTROL=RULES
MATCHING_AI_TIMEOUT_MS=2000
# Compose sets the internal FastAPI URL and generates a shared key if blank.
# For separate local processes, set the same key (at least 32 characters) on both.
MATCHING_AI_URL=http://127.0.0.1:8000
MATCHING_AI_KEY=
AI_EMBEDDINGS_ENABLED=false
AI_MODEL_LOCAL_ONLY=true
# AI_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# AI_MODEL_REVISION=e8f8c211226b894fcb81acc59f3b34ba3efd5f42


# Notifications: in-app live delivery works without push credentials.
# Use false on API-only replicas and run npm run start:notifications on workers.
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_PUSH_ENABLED=false
# Distinct EAS project UUIDs for the user and partner apps.
NOTIFICATION_USER_PROJECT_ID=
NOTIFICATION_PARTNER_PROJECT_ID=
EXPO_ACCESS_TOKEN=
EXPO_PUSH_RATE_LIMIT=400
# Direct push for larger deployments. Mount credentials as secret files.
NATIVE_PUSH_RATE_LIMIT=1000
FCM_USER_SERVICE_ACCOUNT_FILE=
FCM_PARTNER_SERVICE_ACCOUNT_FILE=
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_KEY_FILE=
APNS_USER_TOPIC=com.mello.app
APNS_PARTNER_TOPIC=com.mello.partner
APNS_SANDBOX=false
# Optional separate worker pools: LIVE,CAMPAIGN,PUSH,RECEIPTS
NOTIFICATION_WORKER_CHANNELS=LIVE,CAMPAIGN,PUSH,RECEIPTS
# docker compose up --build
