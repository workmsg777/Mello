PORT=4000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dating_db
DB_USER=dating_user
DB_PASSWORD=dating_password
DB_SSL=false
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
OTP_HASH_SECRET=replace-with-an-independent-long-random-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
OTP_TTL_SECONDS=300
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
DEFAULT_PHONE_COUNTRY_CODE=+91
OTP_DELIVERY_MODE=console
# To send real SMS, set OTP_DELIVERY_MODE=twilio and configure these credentials.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# Use a messaging service above, or a Twilio sender number below.
TWILIO_FROM_NUMBER=
# Local development only. Never enable this in production.
OTP_EXPOSE_IN_RESPONSE=true
PLATFORM_SIGNUP_SECRET=replace-with-a-private-platform-registration-key
DATING_MINIMUM_AGE=18
DATING_MINIMUM_PHOTOS=3
DATING_MAXIMUM_PHOTOS=6
DATING_MINIMUM_INTERESTS=3
DATING_MAXIMUM_INTERESTS=8
DATING_MAXIMUM_PROMPT_ANSWERS=3
CONSENT_POLICY_VERSION=1.0

# docker compose up --build
# Notifications: in-app live delivery works without push credentials.
# Use false on API-only replicas and run npm run start:notifications on workers.
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_PUSH_ENABLED=false
# Distinct EAS project UUIDs for the user and partner apps.
NOTIFICATION_USER_PROJECT_ID=
NOTIFICATION_PARTNER_PROJECT_ID=
EXPO_ACCESS_TOKEN=
EXPO_PUSH_RATE_LIMIT=400
# Direct push for larger deployments. Mount credentials as secret files.
NATIVE_PUSH_RATE_LIMIT=1000
FCM_USER_SERVICE_ACCOUNT_FILE=
FCM_PARTNER_SERVICE_ACCOUNT_FILE=
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_KEY_FILE=
APNS_USER_TOPIC=com.mello.app
APNS_PARTNER_TOPIC=com.mello.partner
APNS_SANDBOX=false
# Optional separate worker pools: LIVE,CAMPAIGN,PUSH,RECEIPTS
NOTIFICATION_WORKER_CHANNELS=LIVE,CAMPAIGN,PUSH,RECEIPTS
