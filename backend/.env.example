PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dating_db
DB_USER=dating_user
DB_PASSWORD=dating_password
DB_SSL=false
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
OTP_HASH_SECRET=replace-with-an-independent-long-random-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
OTP_TTL_SECONDS=300
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
DEFAULT_PHONE_COUNTRY_CODE=+91
OTP_DELIVERY_MODE=console
# Local development only. Never enable this in production.
OTP_EXPOSE_IN_RESPONSE=true
PLATFORM_SIGNUP_SECRET=replace-with-a-private-platform-registration-key
DATING_MINIMUM_AGE=18
DATING_MINIMUM_PHOTOS=3
DATING_MAXIMUM_PHOTOS=6
DATING_MINIMUM_INTERESTS=3
DATING_MAXIMUM_INTERESTS=8
DATING_MAXIMUM_PROMPT_ANSWERS=3
CONSENT_POLICY_VERSION=1.0

# docker compose up --build
